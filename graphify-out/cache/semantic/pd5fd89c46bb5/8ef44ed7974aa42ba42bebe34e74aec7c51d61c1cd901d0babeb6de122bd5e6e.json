{"nodes": [{"id": "readme_hybrid_search_api", "label": "Hybrid Search API (README)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rag_answer_token_cost", "label": "RAG Answer Token Cost", "file_type": "rationale", "source_file": "README.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Averaged over 10 topically matched queries: ~417 prompt + ~343 completion = ~760 tokens per LLM answer. Reported in tokens rather than euros/dollars because the monetary cost depends on the chosen provider's pricing, while the token count is provider-independent and converts directly."}, {"id": "readme_data_sovereignty_mode", "label": "Data-Sovereignty Deployment Mode", "file_type": "rationale", "source_file": "README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For GDPR/regulated scenarios where data must never leave controlled infrastructure, `docker compose --profile local-llm up` runs a local llama.cpp server so the RAG step makes no external call. The app is provider-agnostic: the same LLM_BASE_URL swap works with Ollama, vLLM or TGI."}, {"id": "readme_dataset_toggle", "label": "Dataset Selection (demo / nfcorpus)", "file_type": "concept", "source_file": "README.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 10 sample docs are self-referentially about search/RAG, which demos cleanly but proves nothing about scale. NFCorpus is indexed into a separate suffixed index so both corpora stay searchable side by side with no restart or env var."}, {"id": "readme_nfcorpus_corpus", "label": "NFCorpus Benchmark Corpus", "file_type": "concept", "source_file": "README.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mcp_tool_exposure", "label": "Search Exposed as an MCP Tool", "file_type": "concept", "source_file": "README.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offered as an addition alongside the REST API, not a replacement; exposes one `search` tool wrapping the same answer_search() logic the REST endpoint uses."}, {"id": "readme_agentic_mode", "label": "Agentic Search Mode", "file_type": "concept", "source_file": "README.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in via \"agentic\": true. Useful for vague queries needing a refined follow-up search. use_llm_answer does not apply \u2014 the agentic loop always uses the LLM both to decide and to answer."}, {"id": "readme_roadmap", "label": "Roadmap (reranking, caching, auth)", "file_type": "concept", "source_file": "README.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"label": "README (English)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "community": 2, "community_name": "Architecture (English)", "norm_label": "readme (english)", "_origin": "semantic", "id": "readme_readme_en"}, {"label": "RAG Grounding Example (README)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "community": 2, "community_name": "Architecture (English)", "norm_label": "rag grounding example (readme)", "_origin": "semantic", "id": "readme_rag_example"}, {"label": "scripts/seed_data.py", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "community": 2, "com