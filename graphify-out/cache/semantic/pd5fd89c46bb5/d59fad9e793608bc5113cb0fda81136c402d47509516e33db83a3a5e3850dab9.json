{"nodes": [{"id": "docs_adr_0002_llama_server_for_data_sovereignty_deployments_decision", "label": "ADR-0002: llama-server, not Ollama, for local LLM mode", "file_type": "rationale", "source_file": "docs/adr/0002-llama-server-for-data-sovereignty-deployments.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ollama does not enforce API-key auth by default, so the AuthenticationError branch this project showcases would be silently dead code against it. llama-server genuinely 401s on a wrong key and is CPU-first/GGUF, fitting 'runs on a laptop'. vLLM is the most spec-faithful but assumes a GPU; TGI's compat layer is least mature; LocalAI is redundant with Ollama. Mirror image of ADR-0001: there is no in-process equivalent for chat generation, so the question is which server, not whether."}, {"label": "0002-llama-server-for-data-sovereignty-deployments.md", "file_type": "document", "source_file": "docs/adr/0002-llama-server-for-data-sovereignty-deployments.md", "source_location": "L1", "_origin": "ast", "id": "docs_adr_0002_llama_server_for_data_sovereignty_deployments", "community": 7, "community_name": "ADR-0001: Local sentence-transformers for embeddings, not Ollama", "norm_label": "0002-llama-server-for-data-sovereignty-deployments.md"}, {"label": "ADR-0002: llama-server (not Ollama) for the local/data-sovereignty LLM deployment mode", "file_type": "document", "source_file": "docs/adr/0002-llama-server-for-data-sovereignty-deployments.md", "source_location": "L1", "_origin": "ast", "id": "docs_adr_0002_llama_server_for_data_sovereignty_deployments_adr_0002_llama_server_not_ollama_for_the_local_data_sovereignty_llm_deployment_mode", "community": 7, "community_name": "ADR-0001: Local sentence-transformers for embeddings, not Ollama", "norm_label": "adr-0002: llama-server (not ollama) for the local/data-sovereignty llm deployment mode"}, {"label": "Context", "file_type": "document", "source_file": 