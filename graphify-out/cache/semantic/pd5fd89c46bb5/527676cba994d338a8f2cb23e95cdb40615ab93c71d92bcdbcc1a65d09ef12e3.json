{"nodes": [{"id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_spec", "label": "Agentic RAG via In-Process MCP Dogfooding", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive by design: agentic defaults to False so the fixed pipeline is byte-identical to before. Explicitly not a general-purpose agent framework \u2014 one tool, one bounded loop, no planning or memory beyond a single request."}, {"id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_in_memory_mcp_transport", "label": "In-Memory MCP Transport", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses create_client_server_memory_streams rather than stdio/subprocess: an anyio task group runs the existing MCP server against one end while a ClientSession talks to the other, in-process. Avoids a subprocess spawn and reloading the embedding model per request \u2014 a protocol-shaped call, not a process boundary."}, {"id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_tool_calling_loop", "label": "Three-Round Tool-Calling Loop", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capped at 3 rounds; after the cap the tools argument is dropped to force a text-only response. Marked in-code as a ponytail shortcut \u2014 fixed cap, made configurable only if real usage needs deeper loops."}, {"id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_schema_discovery", "label": "Live MCP Tool-Schema Discovery", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "session.list_tools() returns the real search tool schema, converted to OpenAI tool-calling format. Discovered from the live server rather than hand-duplicated, so a parameter change is picked up automatically."}, {"label": "2026-08-17-agentic-rag-mcp-design.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L1", "_origin": "ast", "id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design", "community": 8, "community_name": "Agentic RAG via in-process MCP dogfooding", "norm_label": "2026-08-17-agentic-rag-mcp-design.md"}, {"label": "Agentic RAG via in-process MCP dogfooding", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L1", "_origin": "ast", "id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_agentic_rag_via_in_process_mcp_dogfooding", "community": 8, "community_name": "Agentic RAG via in-process MCP dogfooding", "norm_label": "agentic rag via in-process mcp dogfooding"}, {"label": "Context", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L7", "_origin": "ast", "id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_context", "community": 8, "community_name": "Agentic RAG via in-process MCP dogfooding", "norm_label": "context"}, {"label": "Goals", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-agentic-rag-mcp-design.md", "source_location": "L20", "_origin": "ast", "id": "docs_superpowers_specs_2026_08_17_agentic_rag_mcp_design_goals", "community": 8, "community_name": "Agentic RAG via in-process MCP dogfooding", "norm_label": "goals"}, {"label": "Non-goals", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-1