# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=documents

# --- LLM (any OpenAI-compatible endpoint, e.g. a company LLM gateway) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=claude-sonnet-4-6

# Data-sovereignty deployment mode: run the LLM step on infrastructure you
# control instead of a cloud gateway - e.g. for data that must not leave your
# own servers. `docker compose --profile local-llm up` starts a local,
# OpenAI-compatible llama-server (see docs/adr/0002-llama-server-for-data-sovereignty-deployments.md
# for why llama-server rather than Ollama). Point the app at it:
# LLM_API_KEY=local-dev-key   # must match LOCAL_LLM_API_KEY below if you set one
# LLM_BASE_URL=http://localhost:8090/v1
# LLM_MODEL=qwen2.5-1.5b
# LOCAL_LLM_API_KEY=local-dev-key   # optional - defaults to local-dev-key

# Simpler local option for casual dev (not data-sovereignty-focused: Ollama
# doesn't enforce the API key, so auth-error handling can't be exercised
# against it) - just swap the three LLM_* values above for these:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
