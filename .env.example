# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=documents

# --- LLM (any OpenAI-compatible endpoint, e.g. a company LLM gateway) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=claude-sonnet-4-6

# Local model via Ollama instead of a cloud gateway - just swap the three
# LLM_* values above for these (Ollama's own API key check ignores the value,
# it just has to be non-empty):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
